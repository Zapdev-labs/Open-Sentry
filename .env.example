DATABASE_URL=postgresql://sentry:sentry@localhost:5432/sentry_clone
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_INGEST_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_ENABLED=false
PORT=3000

# Email (transactional — used by alerts, password reset, invites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Open Sentry <alerts@example.com>"

# Alert webhooks (optional overrides for per-channel secrets)
ALERT_WEBHOOK_SIGNING_SECRET=generate-with-openssl-rand-base64-32

# SSO (optional — SAML or OIDC)
SSO_SAML_CERT=
SSO_SAML_ENTRY_POINT=

